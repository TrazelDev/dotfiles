#######################################
### Variables #########################
#######################################

# Windows as mod key:
set $mod Mod4
set $alt Mod1

# Vim movement variables:
set $left h
set $down j
set $up k
set $right l

# Applications I use:
set $terminal foot
set $applauncher rofi -show drun
set $filemanager thunar
set $notificationcenter swaync-client -t
set $lockscreen swaylock

# Pressing the shortcut for your CURRENT workspace jumps you back to your PREVIOUS one
workspace_auto_back_and_forth yes
floating_modifier $mod

#######################################
### Monitors ##########################
#######################################

# output DP-1 resolution 1920x1080@144Hz position 1920 0
# output HDMI-A-1 resolution 1920x1080@60Hz position 0 0

# workspace 1 output DP-1
# workspace 2 output DP-1
# workspace 3 output DP-1
# workspace 4 output DP-1
# workspace 5 output DP-1
# workspace 6 output DP-1
# workspace 7 output DP-1
# workspace 8 output HDMI-A-1
# workspace 9 output HDMI-A-1
# workspace 10 output HDMI-A-1

#######################################
### Autostart #########################
#######################################

exec swaync
exec obsidian
exec todoist
exec spotify-launcher
exec kdeconnect-app
exec swaymsg 'workspace number 10; exec zen-browser'

exec_always wl-paste --type text --watch cliphist store
exec_always wl-paste --type image --watch cliphist store

# Idle configuration
exec swayidle -w \
    timeout 300 'swaylock -f --screenshots --effect-blur 7x5' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '$lockscreen &'

#######################################
### Looks #############################
#######################################

exec waybar
exec awww-daemon && sleep 2 && awww img ~/.config/personal_photos/wallpaper

default_border pixel 2
default_floating_border pixel 2

client.focused          #e51b24   #1a0507   #ffffff   #ff3344   #e51b24
client.focused_inactive #3b1419   #12080a   #c0a0a0   #3b1419   #3b1419
client.unfocused        #1f1416   #0f0b0c   #7a6e70   #1f1416   #1a1113
client.urgent           #e63946   #e63946   #ffffff   #e63946   #e63946

# Cursor theme:
seat * xcursor_theme Bibata-Modern-Ice 24

#######################################
### Inputs ############################
#######################################

input * {
    xkb_layout "us,il"
    xkb_options "grp:win_space_toggle"
}

#######################################
### Keybindings #######################
#######################################

# Application openings:
bindsym $mod+T exec $terminal
bindsym $mod+E exec $filemanager
bindsym $alt+space exec $applauncher
bindsym $mod+V exec ~/.config/sway/ClipManager.sh
bindsym $mod+N exec $notificationcenter

# Layout changes:
# bindsym $mod+b splith
# bindsym $mod+shift+b splitv
bindsym $mod+P floating toggle
bindsym $mod+o focus parent, layout toggle split, focus child
bindsym $mod+f fullscreen

# Closing applications
bindsym $mod+C exec ~/.config/sway/safe_close.sh
bindsym $mod+Shift+C kill
bindsym Ctrl+$mod+Shift+M exit
bindsym $mod+Q exec systemctl suspend
bindsym $mod+Shift+Q exec $lockscreen


# Movement changes:
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Screenshots:
# Screenshot desktop:
bindsym Print exec grim - | wl-copy
# Screenshot region:
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy

# Switch workspaces:
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1, workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2, workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3, workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4, workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5, workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6, workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7, workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8, workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9, workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10, workspace number 10

# Reloading the sway config:
bindsym $mod+Shift+r reload

# Laptop multimedia keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
# Media Player controls
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

#######################################
### Dedicated App Workspaces ##########
#######################################

# Route apps to named background workspaces on launch
assign [class="(?i)todoist"] workspace ws_todoist
assign [app_id="(?i)todoist"] workspace ws_todoist
assign [class="(?i)obsidian"] workspace ws_obsidian
assign [app_id="(?i)obsidian"] workspace ws_obsidian
assign [class="(?i)spotify"] workspace ws_spotify
assign [app_id="(?i)spotify"] workspace ws_spotify
assign [class="(?i)kdeconnect"] workspace ws_kde
assign [app_id="(?i)kdeconnect"] workspace ws_kde

# Toggle keys (Jumps to the app, pressing again jumps back to your work)
bindsym $mod+d workspace ws_todoist
bindsym $mod+s workspace ws_obsidian
bindsym $mod+a workspace ws_spotify
bindsym $mod+w workspace ws_kde

# Move focused window to dedicated app workspaces
bindsym $mod+Shift+d move container to workspace ws_todoist
bindsym $mod+Shift+s move container to workspace ws_obsidian
bindsym $mod+Shift+a move container to workspace ws_spotify
bindsym $mod+Shift+w move container to workspace ws_kde

bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

#######################################
### Virtual machines ##################
#######################################

# Virtual Machine Workspace
set $launch_kali_vm bash -c 'virsh --connect qemu:///system list --all | grep -q "kali-linux" && virt-manager --show-domain-console "kali-linux" --connect qemu:///system'
exec $launch_kali_vm

assign [title="^(kali-linux on QEMU/KVM)$"] workspace ws_vm

bindsym $mod+Tab workspace ws_vm
bindsym $mod+Shift+Tab move container to workspace ws_vm
